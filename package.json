{
  "name": "afk-loop",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Personal AFK orchestrator for parallel implementation of vertical-slice GitHub issues using Claude Code (subscription-native, no Docker).",
  "homepage": "https://github.com/nabi-zakaria-dev/afk-loop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabi-zakaria-dev/afk-loop.git"
  },
  "bin": {
    "afk-loop": "./bin/afk-loop.mjs"
  },
  "files": [
    "main.mts",
    "bin",
    "src",
    "prompts",
    "templates",
    "README.md",
    "DESIGN.md",
    "PRD.md",
    "ISSUES.md",
    "CONTEXT.md",
    "docs"
  ],
  "scripts": {
    "afk-loop": "tsx main.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
